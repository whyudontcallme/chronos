    <script>
        // --- Глобальные переменные ---
        let corruptionLevel = 0;
        let iconsSucked = 0;

        // --- 0. Индикатор прогресса скролла ---
        const scrollProgress = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const scrollPercent = (scrollTop / docHeight) * 100;
            scrollProgress.style.width = scrollPercent + '%';
        });

        // --- 0.1 Эффект навигации при скролле ---
        const nav = document.querySelector('nav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // --- 1. Spotlight эффект ---
        const spotlight = document.getElementById('spotlight');
        document.addEventListener('mousemove', (e) => {
            spotlight.style.left = e.clientX + 'px';
            spotlight.style.top = e.clientY + 'px';
        });

        // --- 2. 3D Монстр (Three.js) — живая сущность с улучшенными шейдерами ---
        const canvas = document.getElementById('monster-canvas');
        const canvasContainer = document.getElementById('monster-canvas-container');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setSize(500, 500);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // Включаем тени и улучшенное качество
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.2;

        // Свет
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);

        // Основной свет с тенью
        const mainLight = new THREE.DirectionalLight(0xffffff, 1);
        mainLight.position.set(5, 8, 5);
        mainLight.castShadow = true;
        scene.add(mainLight);

        // Цветные акцентные света — белые/серые тона
        const pointLight1 = new THREE.PointLight(0xffffff, 2, 30);
        pointLight1.position.set(8, 8, 8);
        scene.add(pointLight1);

        const pointLight2 = new THREE.PointLight(0xe0e0e0, 1.5, 25);
        pointLight2.position.set(-8, -8, 8);
        scene.add(pointLight2);

        const pointLight3 = new THREE.PointLight(0xc0c0c0, 1, 20);
        pointLight3.position.set(0, 8, -8);
        scene.add(pointLight3);

        // Дополнительный свет для глубины
        const pointLight4 = new THREE.PointLight(0xffffff, 0.8, 15);
        pointLight4.position.set(0, 0, 5);
        scene.add(pointLight4);

        // Контровой свет для краёв
        const rimLight = new THREE.DirectionalLight(0xffffff, 0.5);
        rimLight.position.set(-5, 0, -5);
        scene.add(rimLight);

        // Создаём шар — белая сущность
        const geometry = new THREE.SphereGeometry(2, 64, 64);

        // Используем стандартный материал для белого эффекта
        const material = new THREE.MeshPhysicalMaterial({
            color: 0xffffff,
            metalness: 0.1,
            roughness: 0.2,
            clearcoat: 1.0,
            clearcoatRoughness: 0.1,
            transparent: true,
            opacity: 0.95,
            side: THREE.FrontSide
        });

        const monster = new THREE.Mesh(geometry, material);
        monster.castShadow = true;
        monster.receiveShadow = true;
        scene.add(monster);

        camera.position.z = 7;

        let time = 0;

        // --- Система частиц вокруг монстра ---
        const particlesContainer = document.getElementById('monster-particles');
        const particles = [];

        function createParticle() {
            const particle = document.createElement('div');
            particle.className = 'particle';
            particlesContainer.appendChild(particle);

            // Случайная позиция вокруг монстра
            const angle = Math.random() * Math.PI * 2;
            const radius = 150 + Math.random() * 100;
            const x = 250 + Math.cos(angle) * radius;
            const y = 250 + Math.sin(angle) * radius;

            particle.style.left = x + 'px';
            particle.style.top = y + 'px';

            // Случайный размер
            const size = 2 + Math.random() * 4;
            particle.style.width = size + 'px';
            particle.style.height = size + 'px';

            // Случайная задержка анимации
            particle.style.animationDelay = Math.random() * 2 + 's';
            particle.style.animationDuration = (2 + Math.random() * 2) + 's';

            particles.push(particle);

            // Удаляем частицу после анимации
            setTimeout(() => {
                particle.remove();
                const idx = particles.indexOf(particle);
                if (idx > -1) particles.splice(idx, 1);
            }, 4000);
        }

        // Создаём частицы периодически
        let particleInterval = setInterval(() => {
            if (Math.random() > 0.3) {
                createParticle();
            }
        }, 200);

        // Обновляем стиль частиц при загрязнении
        function updateParticles() {
            particles.forEach(particle => {
                if (corruptionLevel > 50) {
                    particle.classList.add('corrupted');
                } else {
                    particle.classList.remove('corrupted');
                }
            });
        }

        // Функция загрязнения — сфера становится полностью чёрной
        function corruptMonster() {
            // Плавное изменение цвета - с первой иконки видно изменение
            corruptionLevel = Math.min(corruptionLevel + 8, 100); // 8% за иконку
            const t = corruptionLevel / 100;

            // Прямой переход от белого (255,255,255) к чёрному (0,0,0)
            const r = 255 * (1 - t);
            const g = 255 * (1 - t);
            const b = 255 * (1 - t);

            material.color.setRGB(r / 255, g / 255, b / 255);

            // Плавное изменение материала для эффекта «угасания»
            material.roughness = 0.15 + t * 0.7;
            material.metalness = 0.3 - t * 0.2;
            material.clearcoat = 1.0 - t * 0.7;

            console.log('Corruption:', corruptionLevel.toFixed(1), '% t:', t.toFixed(2), 'RGB:', r.toFixed(0), g.toFixed(0), b.toFixed(0));

            // Логотип
            const logoIcon = document.getElementById('logo-icon');
            logoIcon.style.background = `rgb(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})`;
            logoIcon.style.boxShadow = `0 0 ${20 + t * 25}px rgba(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)}, 0.6)`;

            // Аура
            const auraElement = document.getElementById('monster-aura');
            if (auraElement) {
                auraElement.classList.add('corrupted');
            }

            // Контейнер канваса
            if (canvasContainer) {
                canvasContainer.classList.add('corrupted');
            }

            // Обновляем частицы
            updateParticles();
        }

        // Анимация
        function animate() {
            requestAnimationFrame(animate);
            time += 0.015;
            renderer.render(scene, camera);
        }
        animate();

        // --- 3. Логика иконок ---
        const icons = document.querySelectorAll('.floating-icon');
        const stage = document.querySelector('.monster-stage');
        let iconIndex = 0;
        const iconOrbitRadius = 240; // Радиус орбиты (подальше от сферы)

        // Переменные для орбитального движения
        let iconRotationAngle = 0;
        const iconOrbitSpeed = 0.003;

        // Случайные позиции для иконок при загрузке
        function randomizeIconPositions() {
            icons.forEach((icon, idx) => {
                // Распределяем иконки по кругу с небольшим случайным смещением
                const baseAngle = (idx / icons.length) * Math.PI * 2;
                const randomOffset = (Math.random() - 0.5) * 0.3;
                const angle = baseAngle + randomOffset;
                const radius = iconOrbitRadius + (Math.random() - 0.5) * 40;
                const centerX = 250;
                const centerY = 250;

                const x = centerX + Math.cos(angle) * radius - 20;
                const y = centerY + Math.sin(angle) * radius - 20;

                icon.style.left = x + 'px';
                icon.style.top = y + 'px';
                icon.style.right = 'auto';
                icon.style.bottom = 'auto';

                // Сохраняем базовый угол для каждой иконки
                icon.dataset.baseAngle = baseAngle;
                icon.dataset.randomOffset = randomOffset;
                icon.dataset.orbitRadius = radius;
            });
        }
        randomizeIconPositions();

        // Орбитальное движение с "живым" покачиванием
        function updateIconRotation() {
            iconRotationAngle += iconOrbitSpeed;
            const time = Date.now() * 0.001;

            icons.forEach((icon, idx) => {
                if (icon.classList.contains('sucked')) return;

                const baseAngle = parseFloat(icon.dataset.baseAngle || 0);
                const randomOffset = parseFloat(icon.dataset.randomOffset || 0);
                const orbitRadius = parseFloat(icon.dataset.orbitRadius || iconOrbitRadius);
                const angle = baseAngle + randomOffset + iconRotationAngle;

                const centerX = 250;
                const centerY = 250;

                // Орбитальное движение
                let x = centerX + Math.cos(angle) * orbitRadius - 20;
                let y = centerY + Math.sin(angle) * orbitRadius - 20;

                // "Живое" покачивание — синус + косинус для естественности
                const wobbleX = Math.sin(time * 2 + idx) * 8;
                const wobbleY = Math.cos(time * 1.5 + idx * 0.7) * 8;
                const wobbleScale = 1 + Math.sin(time * 3 + idx * 0.5) * 0.08;

                x += wobbleX;
                y += wobbleY;

                icon.style.left = x + 'px';
                icon.style.top = y + 'px';

                // Лёгкое вращение иконки по направлению движения
                const rotation = (angle + Math.PI / 2) * (180 / Math.PI);
                icon.style.transform = `rotate(${rotation}deg) scale(${wobbleScale})`;
            });

            requestAnimationFrame(updateIconRotation);
        }
        updateIconRotation();

        function suckIcon(icon) {
            const stageRect = stage.getBoundingClientRect();
            const centerX = stageRect.width / 2;
            const centerY = stageRect.height / 2;

            const iconRect = icon.getBoundingClientRect();
            const relativeX = iconRect.left - stageRect.left;
            const relativeY = iconRect.top - stageRect.top;

            // Анимация поглощения — быстрая воронка с вращением
            icon.classList.add('sucked');

            let progress = 0;
            const duration = 700; // мс (чуть медленнее для драматизма)
            const startTime = performance.now();
            const startAngle = Math.atan2(relativeY - centerY, relativeX);
            const spiralRotations = 3; // больше оборотов
            const totalAngle = startAngle + spiralRotations * Math.PI * 2;

            function animateSuck(currentTime) {
                const elapsed = currentTime - startTime;
                progress = Math.min(elapsed / duration, 1);

                // Easing функция - быстрое начало, медленный конец
                const easeInOut = progress < 0.5 
                    ? 4 * progress * progress * progress 
                    : 1 - Math.pow(-2 * progress + 2, 3) / 2;

                // Спиральное движение к центру с ускорением
                const currentAngle = startAngle + totalAngle * easeInOut;
                const currentRadius = (1 - easeInOut) * iconOrbitRadius;

                const newX = centerX + Math.cos(currentAngle) * currentRadius - 20;
                const newY = centerY + Math.sin(currentAngle) * currentRadius - 20;

                // Уменьшение и вращение иконки + пульсация
                const scale = 1 - easeInOut * 0.8;
                const rotation = currentAngle * (180 / Math.PI);
                const pulse = 1 + Math.sin(progress * Math.PI * 4) * 0.1;

                icon.style.left = newX + 'px';
                icon.style.top = newY + 'px';
                icon.style.transform = `scale(${scale * pulse}) rotate(${rotation}deg)`;
                icon.style.opacity = 1 - easeInOut * 0.9;

                if (progress < 1) {
                    requestAnimationFrame(animateSuck);
                } else {
                    // Иконка поглощена
                    icon.style.opacity = '0';
                    icon.style.transform = 'scale(0)';
                    iconsSucked++;
                    corruptMonster();
                }
            }
            
            requestAnimationFrame(animateSuck);
        }

        // Сброс иконок на новые случайные позиции
        function resetIcons() {
            icons.forEach((icon, idx) => {
                icon.classList.remove('sucked');
                icon.classList.remove('emerging');
                icon.style.opacity = '0.9';
                icon.style.filter = '';

                // Новые случайные позиции с новым базовым углом
                const baseAngle = (idx / icons.length) * Math.PI * 2 + Math.random() * 0.6;
                const randomOffset = (Math.random() - 0.5) * 0.3;
                const angle = baseAngle + randomOffset;
                const radius = iconOrbitRadius + (Math.random() - 0.5) * 30;
                const centerX = 250;
                const centerY = 250;

                const x = centerX + Math.cos(angle) * radius - 20;
                const y = centerY + Math.sin(angle) * radius - 20;

                icon.style.left = x + 'px';
                icon.style.top = y + 'px';

                // Обновляем данные для вращения
                icon.dataset.baseAngle = baseAngle;
                icon.dataset.randomOffset = randomOffset;
            });
        }

        // Сброс загрязнения — шар возвращается в белый (плавный цикл)
        function resetCorruption() {
            setTimeout(() => {
                // Иконки вылетают из монстра в разные стороны и возвращаются
                icons.forEach((icon, idx) => {
                    setTimeout(() => {
                        icon.classList.remove('sucked');
                        icon.classList.add('emerging');

                        // Вылет на небольшое расстояние
                        const angle = (idx / icons.length) * Math.PI * 2;
                        const distance = 30 + Math.random() * 20;
                        const moveX = Math.cos(angle) * distance;
                        const moveY = Math.sin(angle) * distance;

                        icon.style.transition = 'all 0.4s ease-out';
                        icon.style.transform = `translate(${moveX}px, ${moveY}px)`;
                        icon.style.opacity = '0.9';

                        // Быстрый возврат на орбиту
                        setTimeout(() => {
                            icon.classList.remove('emerging');
                            icon.style.transition = '';
                            icon.style.transform = '';
                            icon.style.opacity = '';
                        }, 400);
                    }, idx * 60);
                });

                // Плавный сброс цвета сферы
                const resetDuration = 1500; // мс
                const startCorruption = corruptionLevel;
                const startTime = performance.now();

                function animateReset(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / resetDuration, 1);

                    // Плавная функция easing
                    const easeOut = 1 - Math.pow(1 - progress, 3);

                    corruptionLevel = startCorruption * (1 - easeOut);

                    if (progress < 1) {
                        corruptMonster();
                        requestAnimationFrame(animateReset);
                    } else {
                        // Завершение сброса
                        corruptionLevel = 0;
                        material.color.setRGB(1, 1, 1);
                        material.roughness = 0.15;
                        material.metalness = 0.3;
                        material.clearcoat = 1.0;

                        const logoIcon = document.getElementById('logo-icon');
                        logoIcon.style.background = '#ffffff';
                        logoIcon.style.boxShadow = '0 0 20px rgba(255, 255, 255, 0.5)';

                        const auraElement = document.getElementById('monster-aura');
                        if (auraElement) {
                            auraElement.classList.remove('corrupted');
                        }

                        if (canvasContainer) {
                            canvasContainer.classList.remove('corrupted');
                        }

                        updateParticles();

                        iconsSucked = 0;
                        iconIndex = 0;
                        allIconsSucked = false;

                        resetIcons();

                        // Запускаем новый цикл через паузу
                        setTimeout(() => {
                            startIconCycle();
                        }, 1000);
                    }
                }

                requestAnimationFrame(animateReset);
            }, 3000);
        }

        // Запуск цикла поглощения иконок (зацикленная анимация)
        let allIconsSucked = false;
        let cycleInterval = null;

        function startIconCycle() {
            if (cycleInterval) clearInterval(cycleInterval);
            cycleInterval = setInterval(() => {
                if (iconIndex < icons.length) {
                    suckIcon(icons[iconIndex]);
                    iconIndex++;
                } else if (!allIconsSucked && iconsSucked >= icons.length) {
                    allIconsSucked = true;
                    clearInterval(cycleInterval);
                    resetCorruption();
                }
            }, 900); // быстрее поглощение
        }

        // Запускаем первый цикл
        startIconCycle();

        // --- 3. Обработка формы (3 варианта ниже) ---
        const form = document.getElementById('signup-form');
        const formMessage = document.getElementById('form-message');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email-input').value;

            // === ОТПРАВКА ДАННЫХ ===
            // Отправляем через Formspree
            await sendToFormspree(email);
        });

        // --- ВАРИАНТ 1: Formspree (бесплатно до 50 писем/мес) ---
        async function sendToFormspree(email) {
            const FORMSPREE_ID = 'maqloppb'; // Зарегистрируйся на formspree.io
            try {
                const response = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                if (response.ok) {
                    showMessage(null, 'success');
                    form.reset();
                } else {
                    showMessage(null, 'error');
                }
            } catch {
                showMessage(null, 'error');
            }
        }

        // --- ВАРИАНТ 2: Google Sheets (полностью бесплатно) ---
        async function sendToGoogleSheets(email) {
            const SHEET_URL = 'ТВОЙ_GOOGLE_APPS_SCRIPT_URL'; // Инструкцию см. ниже
            try {
                await fetch(SHEET_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, date: new Date().toISOString() })
                });
                showMessage(null, 'success');
                form.reset();
            } catch {
                showMessage(null, 'error');
            }
        }

        // --- ВАРИАНТ 3: Локальное сохранение (для теста) ---
        function saveLocally(email) {
            let emails = JSON.parse(localStorage.getItem('timemonster_emails') || '[]');
            emails.push({ email, date: new Date().toISOString() });
            localStorage.setItem('timemonster_emails', JSON.stringify(emails));
            showMessage(null, 'success');
            form.reset();
        }

        function showMessage(text, type) {
            // Сообщения для разных языков
            const messages = {
                en: {
                    success: '✅ You\'re on the list! Check your email.',
                    error: '❌ Error. Please try again later.',
                    connectionError: '❌ Connection error.'
                },
                ru: {
                    success: '✅ Вы в списке! Проверьте почту.',
                    error: '❌ Ошибка. Попробуйте позже.',
                    connectionError: '❌ Ошибка соединения.'
                }
            };

            // Если текст не передан, используем перевод
            if (!text) {
                text = messages[currentLang][type === 'success' ? 'success' : 'error'];
            }

            formMessage.textContent = text;
            formMessage.className = type;
            setTimeout(() => {
                formMessage.className = '';
            }, 5000);
        }

        // --- 4. Анимация при скролле ---
        const fadeElements = document.querySelectorAll('.fade-in');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });

        fadeElements.forEach(el => observer.observe(el));

        // --- 5. Плавный скролл ---
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // --- 6. Переключение языка ---
        const langBtns = document.querySelectorAll('.lang-btn');
        let currentLang = 'en';

        function switchLanguage(lang) {
            currentLang = lang;
            
            // Обновляем активные кнопки
            langBtns.forEach(btn => {
                if (btn.dataset.lang === lang) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            // Находим все элементы с data-en и data-ru
            document.querySelectorAll('[data-en][data-ru]').forEach(el => {
                const text = el.getAttribute(`data-${lang}`);
                if (text) {
                    el.textContent = text;
                }
            });

            // Сохраняем выбор в localStorage
            localStorage.setItem('chronos_lang', lang);
        }

        // Обработчики кликов на кнопки языка
        langBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                switchLanguage(btn.dataset.lang);
            });
        });

        // Загружаем сохранённый язык при старте
        const savedLang = localStorage.getItem('chronos_lang') || 'en';
        switchLanguage(savedLang);
    </script>
</body>
</html>
